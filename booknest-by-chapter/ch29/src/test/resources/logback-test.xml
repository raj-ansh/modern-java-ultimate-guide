<configuration>

  <!-- While tests run: only errors, on the console, and no files -->
  <appender name="CONSOLE"
            class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="ERROR">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
